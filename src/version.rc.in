#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @AUTOZWJ_VERSION_FILE@
 PRODUCTVERSION @AUTOZWJ_VERSION_FILE@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TNOTawa\0"
            VALUE "FileDescription", "AutoZWJ - AviUtl2 object importer\0"
            VALUE "FileVersion", "@AUTOZWJ_VERSION_STR@\0"
            VALUE "InternalName", "AutoZWJ\0"
            VALUE "LegalCopyright", "Copyright (c) TNOTawa\0"
            VALUE "OriginalFilename", "AutoZWJ.aux2\0"
            VALUE "ProductName", "AutoZWJ\0"
            VALUE "ProductVersion", "@AUTOZWJ_VERSION_STR@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
